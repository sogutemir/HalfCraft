<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClCompile Remove="..\..\cl_dll\cdll_int.cpp;..\..\cl_dll\input.cpp;..\..\cl_dll\inputw32.cpp;..\..\cl_dll\view.cpp;..\..\cl_dll\tri.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)client_cdll.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)client_input.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)client_mouse.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)client_view.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)client_tri.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)client.cpp" />
  </ItemGroup>
  <ItemDefinitionGroup>
    <ClCompile><LanguageStandard>stdcpp17</LanguageStandard></ClCompile>
    <Link><AdditionalDependencies>opengl32.lib;%(AdditionalDependencies)</AdditionalDependencies><GenerateMapFile>true</GenerateMapFile><MapFileName>$(OutDir)client.map</MapFileName></Link>
  </ItemDefinitionGroup>
</Project>
